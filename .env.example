# ==================== LexGuide AI — environment config ====================
ENV=development

# --- Database ---------------------------------------------------------
# Prototype default (zero setup): SQLite.
DATABASE_URL=sqlite:///./lexguide.db
# Production (Postgres + pgvector upgrade path — see docs/architecture.md):
# DATABASE_URL=postgresql+psycopg://lexguide:lexguide@postgres:5432/lexguide

# --- Storage -----------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- AI provider ---------------------------------------------------------
# demo = fully offline, deterministic, zero-cost (default; whole app works with no key)
# anthropic = calls the real Claude API
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,*

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- Frontend --------------------------------------------------------------
# Set this in frontend/config.js if serving the API from a different host/port.
LEXGUIDE_API_BASE=http://127.0.0.1:8000
